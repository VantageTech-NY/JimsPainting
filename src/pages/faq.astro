---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BUSINESS, PAINT_BRANDS, SERVICE_TOWNS } from "../consts";

// FAQ content adapted from the owner's v1 answers + updated info (towns, HIC#,
// paint brands). Drives both the page and the FAQPage schema (plan2.md 6.4 /
// 3.1). Draft — owner sign-off pending (plan2.md 5.7).
const faqs = [
  {
    q: "What areas do you serve?",
    a: `We serve homeowners and businesses across Central Connecticut — including ${SERVICE_TOWNS.join(", ")}, and surrounding towns. Not sure if your area is covered? Give us a call.`,
  },
  {
    q: "What kinds of painting do you do?",
    a: "Both interior and exterior, residential and commercial — plus cabinet refinishing, deck and fence staining, and board & batten installation.",
  },
  {
    q: "Are you licensed and insured?",
    a: `Yes. We're a registered Connecticut Home Improvement Contractor (${BUSINESS.licenseLabel} #${BUSINESS.licenseNumber}) and fully insured. We're happy to provide a certificate on request.`,
  },
  {
    q: "What paint do you use?",
    a: `We use quality ${PAINT_BRANDS.join(" and ")} paints, matched to the job — no bargain substitutes that fade or peel in a season.`,
  },
  {
    q: "How do I get a quote?",
    a: "Whatever works best for you — call, email, or submit the quote form on our contact page. Quotes are free, there's no pressure, and we'll usually get back to you the same day.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const description =
  "Common questions about Jim's Quality Painting — service area, licensing and insurance, the paint we use, and how to get a free quote.";
---

<BaseLayout title="FAQ" description={description}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />

  {/* Header */}
  <section class="page-header">
    <div class="container container--narrow stack-l">
      <span class="chip">FAQ</span>
      <h1>Questions, answered.</h1>
      <p class="hero-lead">
        A few of the things people ask most. Don't see yours? <a
          href={BUSINESS.phoneHref}>Give us a call</a
        >.
      </p>
    </div>
  </section>

  {/* FAQ accordion */}
  <section class="section section--tint">
    <div class="container container--narrow">
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item" data-reveal>
              <summary>{f.q}</summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* CTA band */}
  <section class="section section--teal">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">Free quote</span>
        <h2>Still have a question?</h2>
        <p>Call us or send a message — happy to help.</p>
      </div>
      <hr class="cut-line" />
      <div class="hero-actions" data-reveal>
        <a class="btn btn--on-teal" href="/contact/">Get a free quote</a>
        <a class="btn btn--ghost" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

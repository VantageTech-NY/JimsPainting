---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import {
  BUSINESS,
  PAINT_BRANDS,
  SERVICES,
  SERVICE_TOWNS,
  TESTIMONIALS,
} from "../consts";
import hero from "../assets/photos/hero.png";
import workLargeHome from "../assets/photos/large-home-after.jpg";
import workVictorian from "../assets/photos/victorian-home-front-after.jpeg";
import workCabinets from "../assets/photos/kitchen-cabinets-wide-after.jpg";
import workPorch from "../assets/photos/front-porch-after.jpeg";

// DRAFT copy — owner sign-off pending (plan2.md 5.7).
const values = [
  {
    icon: "shield-check" as const,
    title: "Licensed & insured",
    body: `${BUSINESS.licenseLabel} #${BUSINESS.licenseNumber}, fully insured. The paperwork is in order before we ever pick up a brush.`,
  },
  {
    icon: "clock" as const,
    title: "20+ years on the job",
    body: "Two decades painting Central Connecticut homes and businesses — and most of our work comes from referrals.",
  },
  {
    icon: "droplet" as const,
    title: "Quality paint, always",
    body: `We use ${PAINT_BRANDS.join(" and ")} — no bargain substitutes that fade or peel in a season.`,
  },
  {
    icon: "check-circle" as const,
    title: "Free, honest quotes",
    body: "We walk the space, talk through what you want, and give you a clear price. No pressure, no surprises.",
  },
];

const work = [
  { img: workLargeHome, alt: "A two-story home after a full exterior repaint", cap: "Full exterior repaint" },
  { img: workVictorian, alt: "A Victorian home repainted in a period color scheme", cap: "Victorian, period colors" },
  { img: workCabinets, alt: "Kitchen cabinets after refinishing", cap: "Cabinet refinishing" },
  { img: workPorch, alt: "A front porch after being refinished", cap: "Front porch refinish" },
];

const description =
  "Licensed, insured painting in Central Connecticut — interior, exterior, cabinets, decks, and board & batten. Over 20 years. Free quotes.";
---

<BaseLayout title="" description={description}>
  {/* ---------- Hero ---------- */}
  <section class="hero">
    <div class="hero-inner container">
      <div class="stack-l">
        <span class="chip">Central Connecticut</span>
        <h1>Painting done right, the first time.</h1>
        <p class="hero-lead">
          {BUSINESS.name} has finished homes and businesses across Central
          Connecticut for over 20 years — clean lines, honest quotes, no surprises.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="/contact/">Get a free quote</a>
          <a class="btn btn--secondary" href={BUSINESS.phoneHref}
            >Call {BUSINESS.phone}</a
          >
        </div>
        <p class="hero-trust">
          Licensed &amp; insured · {BUSINESS.licenseLabel} #{BUSINESS.licenseNumber} ·
          {PAINT_BRANDS.join(" & ")} paints
        </p>
      </div>

      <div class="hero-media">
        <Image
          src={hero}
          alt="Colonial home in Central Connecticut after refinishing by Jim's Quality Painting"
          widths={[480, 800, 1200]}
          sizes="(max-width: 52rem) 100vw, 600px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* ---------- Why Jim ---------- */}
  <section class="section">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">Why Jim's</span>
        <h2>A painter you can actually count on.</h2>
      </div>
      <div class="value-grid reveal-stagger">
        {
          values.map((v) => (
            <div class="value-item" data-reveal>
              <span class="icon-badge"><Icon name={v.icon} /></span>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Services ---------- */}
  <section class="section section--tint">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">What we do</span>
        <h2>A painter for the whole house.</h2>
      </div>
      <div class="card-grid reveal-stagger">
        {
          SERVICES.map((s) => (
            <a class="card stack" href={`/services/${s.slug}/`} data-reveal>
              <h3>{s.title}</h3>
              <p>{s.blurb}</p>
              <span class="card-more">Learn more <Icon name="arrow-right" /></span>
            </a>
          ))
        }
      </div>
      <p data-reveal>
        <a href="/services/">View all services →</a>
      </p>
    </div>
  </section>

  {/* ---------- Recent work ---------- */}
  <section class="section">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">Recent work</span>
        <h2>Real homes, real Connecticut.</h2>
      </div>
      <div class="work-grid reveal-stagger">
        {
          work.map((w) => (
            <figure class="work-item" data-reveal>
              <Image
                src={w.img}
                alt={w.alt}
                widths={[320, 640]}
                sizes="(max-width: 52rem) 50vw, 280px"
                loading="lazy"
              />
              <figcaption class="work-cap">{w.cap}</figcaption>
            </figure>
          ))
        }
      </div>
      <p data-reveal>
        <a href="/gallery/">See more projects →</a>
      </p>
    </div>
  </section>

  {/* ---------- Testimonials (real Google reviews) ---------- */}
  <section class="section section--tint">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">What clients say</span>
        <h2>Work that speaks for itself.</h2>
      </div>
      <div class="quote-grid reveal-stagger">
        {
          TESTIMONIALS.map((t) => (
            <figure class="quote-card" data-reveal>
              <blockquote>{t.quote}</blockquote>
              <cite>— {t.author}</cite>
            </figure>
          ))
        }
      </div>
      <p data-reveal>
        <a href={BUSINESS.reviewsUrl} rel="noopener" target="_blank">
          Read more on Google →
        </a>
      </p>
    </div>
  </section>

  {/* ---------- Service area ---------- */}
  <section class="section">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">Service area</span>
        <h2>Serving Central Connecticut.</h2>
        <p>
          We work throughout Central Connecticut, including these towns. Not sure
          if we cover yours? <a href={BUSINESS.phoneHref}>Give us a call</a> — we
          probably do.
        </p>
      </div>
      <ul class="town-list" data-reveal>
        {SERVICE_TOWNS.map((town) => <li class="town">{town}</li>)}
      </ul>
    </div>
  </section>

  {/* ---------- Cut-line / proof band ---------- */}
  <section class="section section--teal">
    <div class="container stack-l">
      <div class="eyebrow-gap" data-reveal>
        <span class="chip">The cut line</span>
        <h2>Where one color meets the next, we keep it crisp.</h2>
        <p>
          That edge is the whole job. Get a free, no-pressure quote and we'll
          walk the space with you.
        </p>
      </div>
      <hr class="cut-line" />
      <div class="hero-actions" data-reveal>
        <a class="btn btn--on-teal" href="/contact/">Get a free quote</a>
        <a class="btn btn--ghost" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import { getImage } from "astro:assets";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";
// Preload only the display font (drives the large headings — the CLS-critical
// element). Body font keeps font-display:swap. Preloading both starved the LCP
// image on throttled mobile. Same hashed URL the @font-face requests.
import bricolageFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import shareSource from "../assets/photos/hero.png";
import { BUSINESS, IS_DEMO, SERVICES, SERVICE_TOWNS } from "../consts";

interface Props {
  /** Page <title>; the business name is appended automatically. */
  title: string;
  description?: string;
  /** Override the default share/OG image with an absolute or site-relative URL. */
  ogImage?: string;
  /** Force noindex even on prod (e.g. /thanks/, /404). */
  noindex?: boolean;
}

const { title, description = BUSINESS.tagline, ogImage, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${BUSINESS.name}` : BUSINESS.name;

// Canonical + OG URLs are derived from Astro.site (driven by SITE_URL), so the
// one-variable demo->prod flip carries through here (plan2.md 1.2).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Default share image — a 1200x630 crop of the hero, generated at build time.
const share = await getImage({
  src: shareSource,
  width: 1200,
  height: 630,
  format: "jpg",
});
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL(share.src, Astro.site).href;

// Site-wide LocalBusiness (HousePainter) schema (plan2.md 3.1 / 4). Inline
// JSON-LD is data, not executable, so it is allowed under CSP script-src 'self'.
// Per-page Service/FAQPage schema is injected separately via the head slot.
// Email is owner-approved; sameAs (socials) omitted until the owner has any.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HousePainter",
  "@id": `${Astro.site}#business`,
  name: BUSINESS.name,
  description: BUSINESS.tagline,
  url: Astro.site?.href,
  telephone: BUSINESS.phoneE164,
  email: BUSINESS.email,
  image: ogImageUrl,
  address: {
    "@type": "PostalAddress",
    addressRegion: BUSINESS.region,
    addressCountry: BUSINESS.country,
  },
  areaServed: SERVICE_TOWNS.map((name) => ({
    "@type": "City",
    name: `${name}, ${BUSINESS.region}`,
  })),
  hasMap: BUSINESS.mapsUrl,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Painting services",
    itemListElement: SERVICES.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: s.title,
        url: new URL(`/services/${s.slug}/`, Astro.site).href,
      },
    })),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14424e" />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={bricolageFont} as="font" type="font/woff2" crossorigin />

    {/* Demo gating (plan2.md 0.2) + per-page opt-out (e.g. /thanks/). */}
    {(IS_DEMO || noindex) && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph / social */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Site-wide business schema. Per-page Service/FAQPage schema is injected
        by pages through the head slot below. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(businessSchema)}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/*
      Progressive enhancement only — external static file (CSP script-src
      'self', no inline). The site is fully usable with this script absent.
    */}
    <script src="/js/enhance.js" defer is:inline></script>
  </body>
</html>

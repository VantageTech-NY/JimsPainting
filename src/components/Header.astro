---
import { BUSINESS, NAV } from "../consts";

// Highlight the current top-level section.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/">{BUSINESS.name}</a>

    <button
      class="nav-burger"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Phone is visible on every page — calls convert best for this audience. */}
    <a class="header-phone" href={BUSINESS.phoneHref}>
      <span aria-hidden="true">☎</span> {BUSINESS.phone}
    </a>
  </div>
</header>

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Before/after comparison slider (plan2.md 3.1 signature element). A full-width
// range input drives a CSS var via gallery.js for pointer drag + keyboard, and
// degrades to a static 50/50 split with no JS. CSP-safe: the var is updated via
// CSSOM (not an inline style attribute), default lives in the stylesheet.
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
}
const { before, after, alt } = Astro.props;
const widths = [400, 800];
const sizes = "(max-width: 52rem) 100vw, 560px";
---

<div class="ba">
  <Image
    class="ba-img"
    src={after}
    alt={`After — ${alt}`}
    widths={widths}
    sizes={sizes}
    loading="lazy"
  />
  <div class="ba-before">
    <Image
      class="ba-img"
      src={before}
      alt={`Before — ${alt}`}
      widths={widths}
      sizes={sizes}
      loading="lazy"
    />
  </div>

  <span class="ba-tag ba-tag--before">Before</span>
  <span class="ba-tag ba-tag--after">After</span>

  <div class="ba-divider" aria-hidden="true"></div>
  <div class="ba-handle" aria-hidden="true">
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m11 8-4 4 4 4"></path>
      <path d="m13 8 4 4-4 4"></path>
    </svg>
  </div>

  <input
    class="ba-range"
    type="range"
    min="0"
    max="100"
    value="50"
    aria-label={`Reveal before and after — ${alt}`}
  />
</div>

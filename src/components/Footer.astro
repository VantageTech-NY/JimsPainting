---
import { Image } from "astro:assets";
import { BUSINESS, SERVICE_TOWNS, PAINT_BRANDS } from "../consts";
import logo from "../assets/logo.jpg";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-brand stack">
      <Image
        class="footer-logo"
        src={logo}
        alt="Jim's Quality Painting logo"
        width={120}
        height={120}
        loading="lazy"
      />
      <p class="footer-name">{BUSINESS.name}</p>
      <p>{BUSINESS.tagline}</p>
      <p>
        <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      </p>
      <p class="footer-license">
        Licensed &amp; insured — {BUSINESS.licenseLabel} #{BUSINESS.licenseNumber}
      </p>
      <p class="footer-license">
        We use {PAINT_BRANDS.join(" & ")} paints.
      </p>
    </div>

    <div class="footer-area">
      <h2>Service area</h2>
      <p>Central Connecticut, including:</p>
      <ul>
        {SERVICE_TOWNS.map((town) => <li>{town}</li>)}
      </ul>
    </div>
  </div>

  <div class="container">
    <p class="footer-copy">© {year} {BUSINESS.name}. All rights reserved.</p>
  </div>
</footer>
